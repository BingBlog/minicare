        <mxCell id="bandA" value="核心问题 —— 过敏管理是长期连续过程（排敏数周 · 转奶数月），却只能靠记忆与零散记录" style="swimlane;startSize=34;html=1;fillColor=#fbfbfb;strokeColor=#aaaaaa;fontSize=14;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
