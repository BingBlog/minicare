# MinerU 云端 API（https://mineru.net/apiManage 获取）
MINERU_API_TOKEN=sk-xxxx

# MySQL（入库阶段用，只读账号即可）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=xxxx
DB_NAME=minicare_dev

# TokenHub API Key（腾讯云大模型服务平台，https://console.cloud.tencent.com/tokenhub 获取）
TOKENHUB_API_KEY=sk-tp-xxxx

# TokenHub 向量模型（默认 0.6b=1024 维；可切 4b=2560 维，实测中文场景 0.6b 更优）
TOKENHUB_EMBEDDING_MODEL=kinfra-text-embedding-0.6b

# LLM（OpenAI 兼容）——关键词抽取 + 元信息 schema 归纳 / 抽值 都走它
# 缺这个变量时上述能力会**降级为规则抽取**并在界面上显式标注（不会伪装成 LLM 结果）
DEEPSEEK_API_KEY=sk-xxxx
# 可选：换别的 OpenAI 兼容服务
KB_LLM_BASE_URL=https://api.deepseek.com
KB_LLM_MODEL=deepseek-v4-flash
