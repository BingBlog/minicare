{
  "name": "minicare-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "敏宝管理平台 · 维护端（React 18 + Vite 6 + Tailwind，TECH-015 §4.8 / §17.1）",
  "scripts": {
    "pdfjs:assets": "node scripts/copy-pdfjs.mjs",
    "dev": "npm run pdfjs:assets && vite",
