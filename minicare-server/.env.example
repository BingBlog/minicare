# ⚠️ 此文件仅作示例，不含真实密钥。请在 CloudRun 控制台配置环境变量，不要提交 .env 文件。

# CloudRun 自动注入
PORT=3000

# CloudBase 环境
TCB_ENV_ID=minicare-cloud-6gqledlle0132cbe

# MySQL 数据库（CloudBase 控制台「数据库」→「连接信息」获取）
DB_HOST=
DB_PORT=3306
DB_NAME=minicare-cloud-6gqledlle0132cbe
DB_USER=
DB_PASS=

# JWT 签名密钥（生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=

# 腾讯云 API 密钥（OCR 调用使用，可选）
TCB_SECRET_ID=
TCB_SECRET_KEY=
