# 环境变量说明（此文件可提交 Git，不含真实密钥）
#
# NestJS 多环境加载策略：
#   本地开发：复制此文件为 .env.local，填入本地数据库密码
#             → npm run start:dev  (NODE_ENV=development，自动加载 .env.local)
#   生产环境：CloudRun 控制台「环境变量」直接注入，无需 .env 文件
#             → npm run start:prod (NODE_ENV=production)
#
# ── 服务 ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── 认证 ───────────────────────────────────────────────
# 本地开发设为 true，使用固定验证码 123456（不发真实短信）
# 生产环境不设置或设为 false，走 CloudBase JS SDK 短信验证
AUTH_TEST_MODE=true

# ── 记录时间线（灰度开关）───────────────────────────────
# FEED_READ_SOURCE:
#   union    = 走旧 UNION 查询（默认，稳态）
#   timeline = 走 record_timeline 物化表（新链路）
FEED_READ_SOURCE=union
#
# TIMELINE_WRITE_MODE:
#   best_effort = timeline 双写失败仅告警，不影响主写入（默认，兼容老版本）
#   strict      = timeline 双写失败即报错（仅在需要强一致时开启）
TIMELINE_WRITE_MODE=best_effort

# ── CloudBase ─────────────────────────────────────────
TCB_ENV_ID=minicare-cloud-6gqledlle0132cbe
# AI 专用环境（混元 Token 额度所在环境），不配置则使用主环境
TCB_AI_ENV_ID=
# AI 环境密钥（跨账号时需要单独配置，同账号可留空使用主密钥）
TCB_AI_SECRET_ID=
TCB_AI_SECRET_KEY=

# ── MySQL 数据库 ───────────────────────────────────────
# 本地开发：127.0.0.1:3306，数据库名 minicare_dev
# 生产环境：CloudBase 控制台「数据库」→「连接信息」获取
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minicare_dev
DB_USER=root
DB_PASS=your-password-here

# ── JWT ───────────────────────────────────────────────
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ── 腾讯云 API 密钥（可选，OCR 等功能使用）──────────────
TCB_SECRET_ID=
TCB_SECRET_KEY=
