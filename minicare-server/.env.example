# 环境变量说明（此文件可提交 Git，不含真实密钥）
#
# NestJS 多环境加载策略：
#   本地开发：复制此文件为 .env.local，填入本地数据库密码
#             → npm run start:dev  (NODE_ENV=development，自动加载 .env.local)
#   生产环境：CloudRun 控制台「环境变量」直接注入，无需 .env 文件
#             → npm run start:prod (NODE_ENV=production)
#
# ── 服务 ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CloudBase ─────────────────────────────────────────
TCB_ENV_ID=minicare-cloud-6gqledlle0132cbe

# ── MySQL 数据库 ───────────────────────────────────────
# 本地开发：127.0.0.1:3306，数据库名 minicare_dev
# 生产环境：CloudBase 控制台「数据库」→「连接信息」获取
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minicare_dev
DB_USER=root
DB_PASS=your-password-here

# ── JWT ───────────────────────────────────────────────
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ── 腾讯云 API 密钥（可选，OCR 等功能使用）──────────────
TCB_SECRET_ID=
TCB_SECRET_KEY=
