# tcb CLI 上传前过滤（.tcbignore），语法同 .gitignore
# 注意：.dockerignore 仅在云端 docker build 时生效，不控制上传内容

# 开发依赖（最大体积，必须排除）
node_modules

# 源码（云端从 dist/ 直接运行，不需要 src/）
src
test

# 编译缓存
dist/test
dist/*.tsbuildinfo
dist/tsconfig.tsbuildinfo
dist/tsconfig.build.tsbuildinfo

# 开发工具配置
.git
.gitignore
tsconfig.json
tsconfig.build.json
nest-cli.json

# 环境变量（敏感，不上传；CloudRun 控制台直接注入）
.env
.env.*

# 其他无用文件
coverage
*.log
.DS_Store
migrations
scripts
code*.zip
