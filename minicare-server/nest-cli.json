{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json"
  },
  "watchOptions": {
    "watchAssets": false,
    "watchOptions": {
      "ignored": [
        "dist/**",
        "node_modules/**",
        "migrations/**",
        "scripts/**",
        "functions/**",
        "**/*.json",
        "**/*.md",
        "**/*.sh",
        "**/*.env*"
      ]
    }
  }
}
