# agent-poc 环境变量模板（复制为 .env.local 后填写；.env.local 含密钥已被 .gitignore 保护）
#
# 环境区分（NODE_ENV，见 src/lib/env.js）：
#   - development（默认，npm run start）：加载 .env.local
#   - production（npm run start:prod / CloudRun 容器）：不读任何本地 env 文件，
#     CloudRun 部署时环境变量由控制台 EnvParams 管理（不得在部署脚本 EnvParams 传入会整体替换）

# ── 必填 ────────────────────────────────────────────────
# DeepSeek API Key（/chat 可用性由它决定，缺失时 ready=false 不崩溃）
DEEPSEEK_API_KEY=

# ── FlexDB 会话持久化（可选；缺省时降级内存会话）─────────
# 生产由 CloudRun EnvParams 注入；本地建议用 minicare-server/.env.local 的长期密钥
# （tcb CLI 登录态为开发兜底，临时凭证会过期）
TCB_ENV_ID=minicare-cloud-6gqledlle0132cbe
TCB_SECRET_ID=
TCB_SECRET_KEY=
# TCB_SESSION_TOKEN=

# ── 知识库只读连接（可选；缺省检索降级为"未找到"）────────
DB_HOST=
DB_PORT=21002
DB_NAME=minicare_dev
DB_USER=
DB_PASSWORD=

# ── 运行时向量化（可选；缺省仅 FULLTEXT 检索）───────────
TOKENHUB_API_KEY=

# ── 服务行为 ────────────────────────────────────────────
# 内部调用令牌（与 minicare-server 共享，生产必配；缺省跳过鉴权并告警）
# AGENT_INTERNAL_TOKEN=
# PORT=3000
# MODEL_DEFAULT=deepseek-v4-flash
# MODEL_VISION=deepseek-v4-flash-vision-exp
# OAK_DEBUG=1

# ── 本地 Langfuse 观测（TECH-007，脚本 traces:import 用）──
# 首次部署后在 http://localhost:3100 创建 Project API Key 填入
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
