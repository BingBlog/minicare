# 环境变量说明（此文件可提交 Git，不含真实密钥）
#
# Vite 多环境加载顺序（优先级从高到低）：
#   .env.local          → 本地私密覆盖，不提交 Git
#   .env.development    → npm run dev 时生效（连接 localhost 后端）
#   .env.production     → npm run build 时生效（连接线上 CloudRun 后端）
#
# CloudBase 环境 ID（两个环境共用同一个 CloudBase 实例）
VITE_TCB_ENV_ID=minicare-cloud-xxxxxxxx

# PWA：与静态托管路径一致。staging 构建用 /staging/，生产构建用 /
VITE_APP_BASE_PATH=/

# 后端 API 地址
# 本地开发：http://localhost:3000
# 生产环境：https://minicare-cloud-xxxxxxxx-xxxxxxxxxx.ap-shanghai.app.tcloudbase.com
VITE_API_BASE_URL=https://your-cloudrun-domain.tcloudbase.com
